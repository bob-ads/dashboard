# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@host:5432/dashboard?sslmode=require"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-random-32-char-secret-here"
AUTH_SECRET="generate-a-random-32-char-secret-here"

# Google Sheets API (Service Account)
GOOGLE_SERVICE_ACCOUNT_EMAIL="dashboard@your-project.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Cron Secret (for Vercel Cron job authentication)
CRON_SECRET="generate-a-random-secret-here"
